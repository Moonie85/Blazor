@page "/directions/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Direction</h2>
    <hr /> *@
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@direction.direction_name</h1>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />


        @* <dl class="row">
            <dt class="col-sm-2">direction_name</dt>
            <dd class="col-sm-10">@direction.direction_name</dd>
        </dl> *@

        <div class="mt-4">
            <h4>Группы этого направления:</h4>
            @if (groups is null || !groups.Any())
            {
                <p class="text-muted">По этому направлению пока не создано ни одной группы.</p>
            }
            else
            {
                <table class="table table-striped table-hover mt-2">
                    <tbody>
                        @foreach (var g in groups)
                        {
                            <tr>
                                <td>@g.group_name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div>
            @* <a href="@($"/directions/edit?direction_id={direction.direction_id}")">Edit</a> | *@
            <a href="@($"/directions")">Back to List</a>
        </div>
    }
</div>

@code {
    private Direction? direction;

    private List<Group>? groups;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NotFound();
        }
        else
        {
            groups = await context.Groups
                .Where(g => g.direction == direction_id)
                .ToListAsync();
        }
    }
}
