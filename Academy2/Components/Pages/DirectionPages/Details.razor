@page "/directions/details"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Direction</h2>
    <hr /> *@
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        @* <h1>@direction.direction_name</h1> *@
        <div class="controls">
            <h1>@direction.direction_name</h1>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />


        <dl class="row">
            <dt class="col-sm-2">Количество групп</dt>
            <dd class="col-sm-10">@direction.Groups.Count</dd>
        </dl>

        <div class="mt-4">
            <h4>Группы этого направления:</h4>
            @if (groups is null || !groups.Any())
            {
                <p class="text-muted">По этому направлению пока не создано ни одной группы.</p>
            }
            else
            {
                <table class="table table-striped table-hover mt-2">
                    <tbody>
                        @foreach (var g in groups)
                        {
                            <tr>
                                <td>@g.group_name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div>
            @* <a href="@($"/directions/edit?direction_id={direction.direction_id}")">Edit</a> | *@
            <a href="@($"/directions")">Back to List</a>
        </div>

        @* <h3>Группы</h3>
        <ul>
            @foreach (Group group in direction.Groups)
            {
                <li>@group.group_name</li>
            }
        </ul> *@

        @* <QuickGrid Items="direction.Groups.AsQueryable()" Class="table">
            <PropertyColumn Sortable="true" Property="group => group.group_name"
            <PropertyColumn Sortable="true" Property="group => group.Student.Count"

        </QuickGrid> *@
    }
</div>

@code {
    private Direction? direction;

    private List<Group>? groups;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions
        .Include(d => d.Groups)
        // .ThenInclude()
        .FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NotFound();
        }
        else
        {
            groups = await context.Groups
                .Where(g => g.direction == direction_id)
                .ToListAsync();
        }
    }
}
