@using Academy2.Models;
@using Microsoft.EntityFrameworkCore;
@inject IDbContextFactory<Academy2Context> DbFactory;


<h5>ChooseGroup</h5>

                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="group" class="form-label">group:</label>
                    @* <InputNumber id="group" @bind-Value="Student.group" class="form-control" aria-required="true"/> *@
                    <InputSelect id="group" @bind-Value="Student.group">
                        @using (Academy2Context context = DbFactory.CreateDbContext())
                        {
                            foreach (Group group in context.Groups)
                            {
                                <option value="@group.group_id">@group.group_name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Student.group" class="text-danger" />
                </div>


@code 
{
    [Parameter]
    public Student Student { get; set; }

}
