@page "/groups"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">
    <h1>Группа</h1>

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>

    <p>
        <input type="text" placeholder="Поиск по названию..." @bind="searchString" @bind:event="oninput" />
    </p>
</div>

@* <QuickGrid Class="table" Items="context.Groups.Include(g => g.Direction)" Pagination="@pagination"> *@
<QuickGrid Class="table" Items="FilteredGroups" Pagination="@pagination">
    <PropertyColumn Property="group => group.group_name" Title="Название группы" Sortable="true" />
    <PropertyColumn Property="group => group.Direction.direction_name" Title="Направление" Sortable="true" />
    <PropertyColumn Property="group => new Week((int)(group.learning_days ?? 0))" Title="Учебные дни" />
    @* <PropertyColumn Property="group => group.learning_days" Title="Дни обучения" Sortable="true" /> *@
    <PropertyColumn Property="group => group.start_time" Title="Время" Sortable="true" />
    <PropertyColumn Property="group => group.start_date" Title="Дата начала" Sortable="true" />

    <TemplateColumn Context="group">
        @* <a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> | *@
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a> 
        @* <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a> *@
    </TemplateColumn>
</QuickGrid>

<Paginator State="@pagination" />

@code {
    private Academy2Context context = default!;
    
    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    private string searchString = "";

    private IQueryable<Group> FilteredGroups
    {
        get
        {
            var query = context.Groups.Include(g => g.Direction).AsNoTracking();

            if (!string.IsNullOrWhiteSpace(searchString))
            {
                query = query.Where(g => g.group_name.Contains(searchString) || g.Direction.direction_name.Contains(searchString));
            }

            return query;
        }
    }

    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
}
