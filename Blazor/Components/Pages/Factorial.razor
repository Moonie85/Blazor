@page "/Factorial"
@rendermode InteractiveServer

@using System.Numerics;

<h3>Factorial</h3>

<div class="factorial">
    <div>
        <label for = "number">Число для вычисления факториала:</label>
        <input type = "number" 
               id = "number" 
               @bind ="number" 
               @bind:after ="Calculate"
               class =" form-control"/>
        <button @onclick="Calculate" class =" btn-primary">Вычислить</button>
    </div>
    <div id =" factorial-result">@number! = @factorial</div>
</div>

